{
  "name": "@desource/angular-image",
  "version": "0.1.0",
  "description": "Angular components for Desource Image.",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "README.md"],
  "exports": {
    ".": {
      "types": "./dist/public-api.d.ts",
      "import": "./dist/public-api.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "ngc -p tsconfig.lib.json",
    "typecheck": "ngc -p tsconfig.lib.json --noEmit"
  },
  "peerDependencies": {
    "@angular/core": "^19.0.0 || ^20.0.0 || ^21.0.0"
  },
  "dependencies": {
    "@desource/image-core": "workspace:*",
    "ipx": "^3.1.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@desource/image-core": "workspace:*"
  }
}
