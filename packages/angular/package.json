{
  "name": "@desource/image-angular",
  "version": "0.1.0",
  "description": "Production-ready Angular image optimization components, directives, providers, and SSR middleware.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeSource-Labs/image.git",
    "directory": "packages/angular"
  },
  "homepage": "https://github.com/DeSource-Labs/image#readme",
  "bugs": "https://github.com/DeSource-Labs/image/issues",
  "type": "module",
  "sideEffects": false,
  "typesVersions": {
    "*": {
      "server": [
        "types/desource-image-angular-server.d.ts"
      ]
    }
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "scripts": {
    "clean": "rimraf dist test-results coverage .angular demo/dist",
    "clean:modules": "rimraf node_modules",
    "build": "pnpm clean && pnpm build:internal",
    "build:internal": "ng-packagr -p ng-package.json && node ../../scripts/prepare-angular-package.mts",
    "dev": "ng serve demo --port 5174",
    "build:demo": "ng build demo",
    "typecheck": "ngc -p tsconfig.lib.json --noEmit && ngc -p tsconfig.spec.json --noEmit && ngc -p demo/tsconfig.app.json --noEmit",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:unit:coverage": "vitest run --config vitest.config.ts --coverage.enabled --coverage.provider=v8 --coverage.reporter=lcov --coverage.reportsDirectory=coverage",
    "test:e2e": "playwright test --config playwright.config.ts",
    "publish:check": "publint dist && attw --pack dist --ignore-rules=cjs-resolves-to-esm"
  },
  "dependencies": {
    "@desource/image": "workspace:*",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@angular/common": "^19.0.0 || ^20.0.0 || ^21.0.0",
    "@angular/core": "^19.0.0 || ^20.0.0 || ^21.0.0",
    "ipx": "^3.1.1"
  },
  "peerDependenciesMeta": {
    "ipx": {
      "optional": true
    }
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.6.4",
    "@analogjs/vitest-angular": "^2.6.4",
    "@angular/build": "21.2.20",
    "@angular/cli": "21.2.20",
    "@angular/common": "21.2.19",
    "@angular/compiler": "21.2.19",
    "@angular/compiler-cli": "21.2.19",
    "@angular/core": "21.2.19",
    "@angular/platform-browser": "21.2.19",
    "ng-packagr": "21.2.7",
    "typescript": "~5.9.3"
  }
}
