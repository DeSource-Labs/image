{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "../..",
    "types": ["vitest/globals", "node"],
    "paths": {
      "@desource/image-angular": ["./src/public-api.ts"],
      "@desource/image-angular/server": ["./server/src/public-api.ts"]
    }
  },
  "angularCompilerOptions": {
    "strictTemplates": true
  },
  "include": [
    "src/**/*.ts",
    "server/src/**/*.ts",
    "test/**/*.ts",
    "demo/src/**/*.ts",
    "playwright.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["test/e2e/**/*.ts", "dist", "demo/dist"]
}
