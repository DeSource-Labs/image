{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "outDir": "./test-results/tsc",
    "ignoreDeprecations": "6.0",
    "types": ["vitest/globals", "node"],
    "paths": {
      "@desource/image": ["../core/src/index.ts"],
      "@desource/image/kit": ["../core/src/kit.ts"],
      "@desource/image-angular": ["src/public-api.ts"],
      "@desource/image-angular/server": ["server/src/public-api.ts"]
    }
  },
  "angularCompilerOptions": {
    "strictTemplates": true
  },
  "include": ["src/**/*.ts", "server/src/**/*.ts", "test/**/*.ts", "demo/src/**/*.ts"],
  "exclude": ["test/e2e/**/*.ts", "dist", "demo/dist"]
}
