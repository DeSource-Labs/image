{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": "../..",
    "outDir": "./test-results/tsc",
    "types": ["vitest/globals", "node"],
    "paths": {
      "@desource/image": ["../core/src/index.ts"],
      "@desource/image/kit": ["../core/src/kit.ts"]
    }
