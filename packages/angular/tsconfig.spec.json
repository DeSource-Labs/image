{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "../..",
    "types": ["vitest/globals", "node"],
    "paths": {
      "@desource/image": ["../core/src/index.ts"],
      "@common/*": ["../../common/*"],
      "@lib": ["./src/public-api.ts"],
      "@server": ["./server/src/public-api.ts"],
      "@src/*": ["./src/lib/*"]
    }
  },
  "angularCompilerOptions": {
    "strictTemplates": true
  },
  "include": ["src/**/*.ts", "server/src/**/*.ts", "test/**/*.ts"],
  "exclude": ["test/e2e/**/*.ts", "dist", "demo"]
}
