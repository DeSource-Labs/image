{
  "name": "@desource/image-react",
  "version": "0.1.0",
  "description": "High-quality image optimization for React and Next.js with responsive output, deployment-aware provider selection, 46 providers, and IPX.",
  "keywords": [
    "react",
    "nextjs",
    "next-image",
    "image",
    "image-optimization",
    "responsive-images",
    "srcset",
    "picture",
    "image-cdn",
    "ipx",
    "vercel",
    "netlify",
    "aws-amplify"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeSource-Labs/image.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/DeSource-Labs/image#readme",
  "bugs": "https://github.com/DeSource-Labs/image/issues",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "next": [
        "dist/next.d.ts"
      ],
      "server": [
        "dist/server.d.ts"
      ],
      "vite": [
        "dist/vite.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js",
      "default": "./dist/next.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "default": "./dist/vite.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rimraf dist coverage test-results demo/dist",
    "clean:modules": "rimraf node_modules",
    "build": "pnpm clean && pnpm build:internal",
    "build:internal": "pnpm build:lib && pnpm build:types",
    "build:lib": "vite build",
    "build:types": "tsc -p tsconfig.build.json",
    "dev": "vite --config demo/vite.config.ts --port 5176",
    "build:demo": "vite build --config demo/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage.enabled --coverage.provider=v8 --coverage.reporter=lcov --coverage.reportsDirectory=coverage",
    "test:e2e": "playwright test --config playwright.config.ts",
    "publish:check": "publint && attw --pack . --ignore-rules=cjs-resolves-to-esm"
  },
  "dependencies": {
    "@desource/image": "workspace:*"
  },
  "peerDependencies": {
    "ipx": "^3.1.1",
    "next": "^14.0.0 || ^15.0.0 || ^16.0.0",
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0",
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "ipx": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
