{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "../..",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "types": ["svelte", "node"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.svelte",
    "playwright.config.ts",
    "vitest.config.ts",
    "demo/src/**/*.ts",
    "demo/src/**/*.svelte"
  ],
  "exclude": ["dist", "coverage", "test-results", "demo/dist"]
}
