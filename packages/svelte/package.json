{
  "name": "@desource/image-svelte",
  "version": "0.1.0",
  "description": "Production-ready Svelte image components, actions, attachments, providers, and SvelteKit middleware.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeSource-Labs/image.git",
    "directory": "packages/svelte"
  },
  "homepage": "https://github.com/DeSource-Labs/image#readme",
  "bugs": "https://github.com/DeSource-Labs/image/issues",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "svelte": "./dist/index.js",
  "typesVersions": {
    "*": {
      "Image.svelte": [
        "dist/Image.svelte.d.ts"
      ],
      "Picture.svelte": [
        "dist/Picture.svelte.d.ts"
      ],
      "vite": [
        "dist/vite.d.ts"
      ],
      "server": [
        "dist/server.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./Image.svelte": {
      "types": "./dist/Image.svelte.d.ts",
      "svelte": "./dist/Image.svelte",
      "import": "./dist/Image.svelte"
    },
    "./Picture.svelte": {
      "types": "./dist/Picture.svelte.d.ts",
      "svelte": "./dist/Picture.svelte",
      "import": "./dist/Picture.svelte"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rimraf dist coverage test-results demo/dist .svelte-kit",
    "clean:modules": "rimraf node_modules",
    "build": "pnpm clean && pnpm build:internal",
    "build:internal": "svelte-package --tsconfig ./tsconfig.build.json",
    "dev": "vite --config demo/vite.config.ts --port 5175",
    "build:demo": "vite build --config demo/vite.config.ts",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage.enabled --coverage.provider=v8 --coverage.reporter=lcov --coverage.reportsDirectory=coverage",
    "test:e2e": "playwright test --config playwright.config.ts",
    "publish:check": "publint && attw --pack . --ignore-rules=cjs-resolves-to-esm"
  },
  "dependencies": {
    "@desource/image": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^5.29.0",
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0",
    "ipx": "^3.1.1"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "ipx": {
      "optional": true
    }
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.5"
  }
}
