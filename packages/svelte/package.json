{
  "name": "@desource/image-svelte",
  "version": "0.1.0",
  "description": "Svelte and SvelteKit components for Desource Image.",
  "type": "module",
  "sideEffects": false,
  "svelte": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./Image.svelte": {
      "types": "./dist/Image.svelte.d.ts",
      "svelte": "./dist/Image.svelte",
      "import": "./dist/Image.svelte"
    },
    "./Picture.svelte": {
      "types": "./dist/Picture.svelte.d.ts",
      "svelte": "./dist/Picture.svelte",
      "import": "./dist/Picture.svelte"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "clean:modules": "rimraf node_modules",
    "build": "pnpm clean && pnpm build:internal",
    "build:internal": "svelte-package",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage.enabled --coverage.provider=v8 --coverage.reporter=lcov --coverage.reportsDirectory=coverage",
    "test:e2e": "playwright test"
  },
  "peerDependencies": {
    "@desource/image": "workspace:*",
    "svelte": "^5.0.0",
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0",
    "ipx": "^3.1.1"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.7",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "svelte": "^5.55.9",
    "svelte-check": "^4.4.8"
  }
}
