{
  "name": "@desource/image",
  "version": "0.1.0",
  "description": "Framework-agnostic image URL, srcset, picture, provider, preset, alias, and placeholder helpers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/desource-labs/image.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/desource-labs/image#readme",
  "bugs": "https://github.com/desource-labs/image/issues",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "kit": [
        "dist/kit.d.ts"
      ],
      "providers": [
        "dist/providers/index.d.ts"
      ],
      "providers/*": [
        "dist/providers/*.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./kit": {
      "types": "./dist/kit.d.ts",
      "import": "./dist/kit.js",
      "default": "./dist/kit.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.js",
      "default": "./dist/providers/index.js"
    },
    "./providers/*": {
      "types": "./dist/providers/*.d.ts",
      "import": "./dist/providers/*.js",
      "default": "./dist/providers/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rimraf dist coverage",
    "clean:modules": "rimraf node_modules",
    "build": "pnpm clean && pnpm build:internal",
    "build:internal": "pnpm build:lib && pnpm build:types",
    "build:lib": "vite build",
    "build:types": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage.enabled --coverage.provider=v8 --coverage.reporter=lcov --coverage.reportsDirectory=coverage",
    "publish:check": "publint && attw --pack . --ignore-rules=cjs-resolves-to-esm"
  },
  "dependencies": {
    "@noble/hashes": "^2.3.0",
    "defu": "^6.1.7",
    "std-env": "^4.1.0",
    "ufo": "^1.6.4"
  },
  "devDependencies": {
    "ipx": "^3.1.1"
  }
}
