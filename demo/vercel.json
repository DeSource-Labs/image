{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "images": {
    "sizes": [640, 768, 1024, 1280, 1536],
    "localPatterns": [
      {
        "pathname": "^/img/.*$",
        "search": ""
      }
    ],
    "minimumCacheTTL": 2678400,
    "formats": ["image/avif", "image/webp"],
    "dangerouslyAllowSVG": false
  }
}
