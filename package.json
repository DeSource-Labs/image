{
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "clean": "pnpm -r --if-present --stream run clean",
    "clean:modules": "pnpm -r --if-present --stream run clean:modules && rimraf node_modules",
    "build": "pnpm -r --filter \"./packages/**\" --stream run build",
    "build:demo": "pnpm --filter @desource/image-demo build",
    "dev:demo": "pnpm --filter @desource/image-demo dev",
    "dev:prepare": "pnpm --filter @desource/image-demo prepare:deps",
    "dev:angular": "pnpm --filter @desource/image-angular dev",
    "dev:react": "pnpm --filter @desource/image-react dev",
    "dev:svelte": "pnpm --filter @desource/image-svelte dev",
    "vercel-build": "pnpm build && pnpm dev:prepare && pnpm build:demo",
    "build:fixtures": "pnpm --filter \"./packages/**\" --parallel run build:demo",
    "build:all": "pnpm build && pnpm dev:prepare && pnpm build:demo && pnpm build:fixtures",
    "check:release": "pnpm format:check && pnpm lint && pnpm check:changesets && pnpm check:peers && pnpm audit:prod && pnpm build:all && pnpm typecheck && pnpm validate:packages && pnpm test:unit:coverage && pnpm test:e2e",
    "check:changesets": "changeset status",
    "check:peers": "pnpm peers check",
    "audit:prod": "pnpm audit --prod",
    "changeset": "changeset",
    "changeset:format-changelogs": "node scripts/format-changelog-dependencies.mts",
    "changeset:sync-changelogs": "node scripts/sync-changelogs.mts",
    "changeset:version": "changeset version && pnpm changeset:format-changelogs && pnpm changeset:sync-changelogs",
    "changeset:publish": "pnpm build && changeset publish --no-git-tag",
    "release:prepare": "node scripts/prepare-github-release.mts",
    "validate:packages": "pnpm -r --filter \"./packages/**\" --if-present --stream run publish:check",
    "test:e2e": "pnpm -r --filter \"./packages/**\" --if-present --stream --workspace-concurrency=1 run test:e2e",
    "test:unit": "pnpm -r --filter \"./packages/**\" --if-present --stream run test:unit",
    "test:unit:coverage": "pnpm -r --filter \"./packages/**\" --if-present --stream run test:unit:coverage",
    "typecheck": "pnpm typecheck:scripts && pnpm -r --if-present --stream run typecheck",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{svelte,vue,html,css,scss,js,jsx,cjs,mjs,ts,tsx,cts,mts,json,jsonc,yml,yaml,md}\"",
    "format:check": "prettier --check \"**/*.{svelte,vue,html,css,scss,js,jsx,cjs,mjs,ts,tsx,cts,mts,json,jsonc,yml,yaml,md}\"",
    "lint:staged": "lint-staged",
    "prepare": "husky"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@eslint/js": "^10.0.1",
    "@nuxt/image": "^2.1.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^4.1.10",
    "angular-eslint": "^22.1.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "publint": "^0.3.23",
    "rimraf": "^6.1.3",
    "svelte-eslint-parser": "^1.8.0",
    "typescript": "~6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{svelte,vue,js,jsx,cjs,mjs,ts,tsx,cts,mts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{html,css,scss,json,jsonc,yml,yaml,md}": [
      "prettier --write"
    ]
  }
}
