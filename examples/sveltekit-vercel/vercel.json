{
  "images": {
    "sizes": [320, 640, 768, 1024, 1280, 1536, 2200],
    "qualities": [50, 60, 70, 75, 80, 90],
    "formats": ["image/avif", "image/webp"],
    "localPatterns": [
      {
        "pathname": "/**"
      }
    ],
    "remotePatterns": [
      {
        "protocol": "https",
